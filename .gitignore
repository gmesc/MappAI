# WHITELIST: sul repo vanno solo i file indispensabili all'app.
# Fonte di verita': "build.files" in package.json. Tutto il resto (md di
# progettazione/architettura, specs, piani, ios/, asset sorgente, sessioni
# Claude) resta locale. Per aggiungere qualcosa: riga "!percorso" qui sotto.

*
!*/

# Repo
!/.gitignore
!/LICENSE
!/README.md
!/THIRD-PARTY-NOTICES.md
!.github/**
!/package.json
!/package-lock.json

# App (Electron main + server)
!/main.js
!/garden-server.js
!/live-server.js
!/tutor-server.js
!/collab-server.js
!/relay-client.js
!relay/**
!/prompts_config.json

# Frontend
!public/**
!tools/voxel-proto/**

# Test (npm test)
!tests/**

# Esclusioni dentro le cartelle ammesse
node_modules/
.DS_Store
*.log
*.bak
*.bak_*
*.bak-*
*.code-workspace
public/dev/
# Copia di lavoro di index.html rimasta indietro: non e' l'app
public/index_classi_nuove_modifiche_manual.html
# Piano di studio ticinese: materiale del DECS, non nostro da ridistribuire
# (resta sul disco, non finisce nel repo ne' negli installer)
public/data/piano-studio-ticino.json
public/esempi/
public/**/*.aseprite
public/**/*.ase
public/**/*.xcf
public/assets/rogue8x8/
prompts_config_backup_*.json
# Test di tool di sviluppo (tools/demo-video, tools/banco-layout), non dell'app
tests/demo-video-core.test.js
tests/studio-layouts.test.js

# Mappe Archify dell'architettura (sorgenti JSON + HTML consegnati + indice);
# gli screenshot/ricevute del visual-check si rigenerano, restano fuori.
!docs/
!docs/archify/**
docs/archify/*.visual-check.*

# Checkpoint prima del motore semantico locale: piani e strumenti richiamati
# dagli script npm, conservati insieme al codice che li usa.
!docs/PIANO-sentence-transformers-locale-2026-09-15.md
!docs/TRACCIA-UDL-revisione-barriere-2026-09-15.md
!docs/ricontrollo-sintesi-2026-09-15.md
!tools/stile/**
!tools/dove.js
# I due script che GENERANO i caratteri committati in public/fonts/: senza di
# loro quegli asset non si rifanno dal repo, e THIRD-PARTY-NOTICES.md cita
# prepara-font.py come la fonte delle modifiche ai font (15/9/2026).
!tools/font/prepara-font.py
!tools/font/emoji-sottoinsieme.py
!tools/font/copertura-glifi.py
!tools/atlante-ui/glossario.js

# Local retrieval: code and reproducible evaluation, never model weights/cache.
!local-ai/**
!docs/GUIDA-banco-validazione-locale.md
local-ai/__pycache__/
!docs/VERIFICA-sentence-transformers-locale-2026-09-15.md
!docs/GUIDA-ricerca-locale.md

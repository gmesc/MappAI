# WHITELIST: sul repo vanno solo i file indispensabili all'app.
# Fonte di verita': "build.files" in package.json. Tutto il resto (md di
# progettazione/architettura, specs, piani, ios/, asset sorgente, sessioni
# Claude) resta locale. Per aggiungere qualcosa: riga "!percorso" qui sotto.

*
!*/

# Repo
!/.gitignore
!.github/**
!/package.json
!/package-lock.json

# App (Electron main + server)
!/main.js
!/garden-server.js
!/live-server.js
!/tutor-server.js
!/collab-server.js
!/relay-client.js
!relay/**
!/prompts_config.json

# Frontend
!public/**
!tools/voxel-proto/**

# Test (npm test)
!tests/**

# Esclusioni dentro le cartelle ammesse
node_modules/
.DS_Store
*.log
*.bak
*.bak_*
*.bak-*
*.code-workspace
public/dev/
public/esempi/
public/**/*.aseprite
public/**/*.ase
public/**/*.xcf
public/assets/rogue8x8/
prompts_config_backup_*.json
# Test di tool di sviluppo (tools/demo-video, tools/banco-layout), non dell'app
tests/demo-video-core.test.js
tests/studio-layouts.test.js

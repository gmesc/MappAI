{
  "name": "mappai",
  "version": "1.0.0-beta.5",
  "description": "MappAI - AI-Powered Mind Mapping and Knowledge Graph Tool",
  "author": {
    "name": "Giacomo Meschini",
    "email": "giacomo@insegnai.ch"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node --test",
    "dove": "node tools/dove.js",
    "stile": "node tools/stile/censimento.js",
    "stile:banco": "node tools/stile/banco.js",
    "ui": "node tools/stile/anatomia.js",
    "local-ai:setup": "python3.13 local-ai/setup.py",
    "test:local-ai": "node --test tests/local-search.test.js",
    "local-ai:review": "node local-ai/review-bank.cjs serve --open"
  },
  "build": {
    "asar": true,
    "files": [
      "main.js",
      "garden-server.js",
      "live-server.js",
      "tutor-server.js",
      "collab-server.js",
      "relay-client.js",
      "relay/relay-core.js",
      "prompts_config.json",
      "public/**",
      "tools/voxel-proto/**",
      "!public/dev/**",
      "!public/**/*.bak*",
      "!public/*.code-workspace",
      "!public/index_classi_nuove_modifiche_manual.html",
      "!public/map_font_config.html",
      "!public/esempi/**",
      "!public/MappAI_logo.svg",
      "!public/data/piano-studio-ticino.json",
      "!public/assets/**/*.aseprite",
      "!public/assets/**/*.ase",
      "!public/assets/**/*.xcf",
      "!public/assets/rogue8x8/**",
      "local-ai/bridge.js"
    ],
    "appId": "com.mappai.generatore",
    "icon": "public/MappAI_icon.png",
    "productName": "MappAI",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Giacomo Meschini <giacomo@insegnai.ch>",
      "category": "Education"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "local-ai",
        "to": "local-ai",
        "filter": [
          "worker.py",
          "setup.py",
          "requirements.txt"
        ]
      }
    ]
  },
  "keywords": [
    "map",
    "node",
    "ai",
    "study"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-library": "^0.8.0",
    "graphology-metrics": "^2.4.0"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "ws": "^8.21.0"
  },
  "allowScripts": {
    "electron@41.10.7": true
  }
}
